    },
    "Faiz, bağlı bankanın Düzenle'deki koşulları ve stopajla her açılışta eklenir: hafta içi kazanç ertesi gün, Cuma–Pazar kazancı Pazartesi. Bankanızın tahakkukundan kuruş farkı olabilir; gerekirse bakiyeyi düzeltin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interest is added each time the app opens, using the linked bank's terms in Edit and the withholding rate: weekday earnings the next day, Friday–Sunday earnings on Monday. It may differ from your bank's accrual by a few kuruş; correct the balance if needed."
          }
        }
      }
    },
    "Faize giren" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earning interest"
