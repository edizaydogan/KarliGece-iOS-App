    "Bakiye kaydı silinsin mi?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete this balance record?"
          }
        }
      }
    },
    "Bakiye ve hareketleri silinir. Bu işlem geri alınamaz." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The balance and its activity will be deleted. This can't be undone."
          }
        }
      }
    },
    "Bakiyelerim" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My Balances"
          }
        }
      }
    },
    "Bakiyelerim, uygulama her açıldığında valörü gelen net faizi bağlı bankanın Düzenle'deki koşulları ve stopajla bakiyeye ekler." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each time the app opens, My Balances adds the net interest whose value date has arrived, using the linked bank's terms in Edit and the withholding rate."
          }
        }
      }
    },
    "Bakiyeyi değiştirirseniz yeni tutar bugün itibarıyla geçerli olur ve eklenen faiz sıfırlanır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you change the balance, the new amount applies as of today and the added interest resets."
          }
        }
      }
    },
    "Bakiyeyi düzenle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
