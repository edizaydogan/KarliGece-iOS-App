            "value" : "Balance"
          }
        }
      }
    },
    "Bakiye bir bankaya bağlanır ve o bankanın koşullarıyla faiz alır. Önce Düzenle'den banka ekleyin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A balance is linked to a bank and earns interest on that bank's terms. Add a bank in Edit first."
          }
        }
      }
    },
    "Bakiye dağılımı (başlangıç)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
